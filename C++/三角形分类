#include <stdio.h>
#include <math.h>

int main(){
	int a,b,c,d,e;
	scanf("%d %d %d",&a,&b,&c) ;
	if(a+b<=c||a+c<=b||b+c<=a){
		printf("不是三角形");
	}
	else{
		if(a*a+b*b==c*c||a*a+c*c==b*b||c*c+b*b==a*a){
			d= (a + b + c) / 2;
			e = sqrt(d * (d - a) * (d - b) * (d - c));
			printf("%d",e);
		}
		else{
			printf("其他三角形");
		}
	}
	return 0;
}
