# ============================================================
#  Vivado / Xilinx SDK 生成物 —— 不入版本库
#  这些都可由 .xpr + .bd + .xdc + 源码 重新生成
# ============================================================

# ---- Vivado 日志/运行时 ----
*.jou
*.log
*.str
*.backup.*
.Xil/

# ---- Vivado 生成目录 ----
**/test.cache/
**/test.runs/
**/test.sim/
**/test.hw/
**/test.ip_user_files/

# ---- Block Design 生成物（design01.bd 本身保留）----
**/test.srcs/sources_1/bd/design01/ip/
**/test.srcs/sources_1/bd/design01/ipshared/
**/test.srcs/sources_1/bd/design01/synth/
**/test.srcs/sources_1/bd/design01/sim/
**/test.srcs/sources_1/bd/design01/hw_handoff/
**/test.srcs/sources_1/bd/design01/hdl/
**/test.srcs/sources_1/bd/design01/ui/
**/test.srcs/sources_1/bd/design01/*.bxml
**/test.srcs/sources_1/bd/design01/*_ooc.xdc
**/test.srcs/sources_1/bd/mref/

# ---- SDK 生成物（shell/src 里的代码保留）----
**/test.sdk/.metadata/
**/test.sdk/.sdk/
**/test.sdk/webtalk/
**/test.sdk/RemoteSystemsTempFiles/
**/test.sdk/shell_bsp/
**/test.sdk/*_hw_platform_*/
**/test.sdk/**/Debug/

# ---- 编译/实现产物 ----
*.o
*.d
*.elf
*.bit
*.hdf
*.xsa
*.dcp
*.xci

# ---- 备份 ----
*.bak
*.bak_*

# ---- 文档构建与临时工作区（不推送）----
docs/work/

# ---- Python / uv 本地环境与缓存 ----
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 本地密钥与私有凭据 ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
*.token
credentials.json
secrets/

# ---- 本地 IDE / 系统文件 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Office / 编辑器临时文件 ----
~$*
*.tmp
*.temp
*.swp
*.swo

# ---- 本地 AI 工具状态 ----
.codex/
.claude/
# ---- Vivado 生成物（任意子目录，通用规则）----
**/*.cache/
**/*.runs/
**/*.sim/
**/*.hw/
**/*.ip_user_files/
**/.Xil/
