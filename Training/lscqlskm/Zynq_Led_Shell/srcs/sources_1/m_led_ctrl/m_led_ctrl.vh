//------------------------------------------------------------------
// Description:
//   M_Led_Ctrl 模块的参数头文件。集中管理计数器位宽与闪烁频率控制位，
//   调整闪烁周期时只改本文件，不触碰 RTL 逻辑。
//------------------------------------------------------------------
`ifndef M_LED_CTRL_VH_PROTECT
`define M_LED_CTRL_VH_PROTECT

//------------------ Include ------------------//
//------------------ Global Define ------------//

/** 闪烁计数器位宽，26 bit @ 50MHz 对应约 1.34s 翻转周期 */
`define M_LED_CTRL_CNT_WIDTH    (26)

/** 取第几位作为 LED 翻转信号，25 对应约 0.67s 亮 + 0.67s 灭 */
`define M_LED_CTRL_BLINK_BIT    (25)

/** 系统时钟频率（Hz），供时序约束参考 */
`define M_LED_CTRL_CLK_FREQ_HZ  (50000000)

//------------------ Private Define -----------//

`endif /* M_LED_CTRL_VH_PROTECT */