{
  "name": "video-downloader",
  "productName": "视频下载器",
  "version": "1.3.1",
  "private": true,
  "description": "简洁的本地视频下载工具",
  "author": "Video Downloader",
  "license": "GPL-3.0-or-later",
  "main": "build-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e.ts",
    "package": "npm run build && electron-builder --mac dir --arm64",
    "dist": "npm run build && electron-builder --mac dmg --arm64",
    "setup:binaries": "node scripts/setup-binaries.mjs",
    "format": "prettier --write electron src tests scripts/*.mjs package.json tsconfig*.json vite.config.ts",
    "dist:win": "node scripts/verify-windows-resources.mjs && npm run build && electron-builder --config electron-builder.win.cjs --win --x64",
    "setup:windows": "node scripts/setup-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.videodownloader.desktop",
    "productName": "视频下载器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      },
      {
        "from": "resources/binaries.json",
        "to": "binaries.json"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "icon": "resources/icon.icns"
    },
    "dmg": {
      "title": "视频下载器",
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
